# Адрес backend для dev-прокси Vite.
# По умолчанию http://localhost:5017 — профиль "http" из launchSettings.json бэкенда.
# Если backend запущен в Docker, обычно http://localhost:8080.
VITE_API_PROXY_TARGET=http://localhost:5017

# Базовый префикс для запросов из кода.
# Пустая строка = запросы идут на тот же origin и попадают в dev-прокси (так и нужно в разработке).
# Для сборки без прокси сюда можно подставить полный адрес API, например http://localhost:5017
VITE_API_BASE_URL=
